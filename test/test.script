-- Test function for rotation-related functions
local function test_rotation(url, vec_in)
	-- Set rotation using different methods
	go.set_euler_t(url, vec_in)
	go.set_euler_x(url, vec_in.x)
	go.set_euler_y(url, vec_in.y)
	go.set_euler_z(url, vec_in.z)

	-- Get rotation using different methods
	local e1_x, e1_y, e1_z = go.get_euler_r(url)
	local e2_x, e2_y, e2_z = go.get_euler_x(url), go.get_euler_y(url), go.get_euler_z(url)
	local e3_out = { x = 0, y = 0, z = 0 }
	go.get_euler_t(url, e3_out)

	-- Collect all x, y, z values
	local x_values = { vec_in.x, e1_x, e2_x, e3_out.x }
	local y_values = { vec_in.y, e1_y, e2_y, e3_out.y }
	local z_values = { vec_in.z, e1_z, e2_z, e3_out.z }

	-- Assert all values are equal
	assert(is_equal(x_values), "Rotation X values differ: " .. format_values(x_values))
	assert(is_equal(y_values), "Rotation Y values differ: " .. format_values(y_values))
	assert(is_equal(z_values), "Rotation Z values differ: " .. format_values(z_values))
end

-- Test function for world getters
local function test_world_getters(url, vec_in)
	-- Set local transform
	go.set_position_t(url, vec_in)
	go.set_scale_t(url, vec_in)
	go.set_euler_t(url, vec_in)

	-- Get world position using different methods
	local wp1_x, wp1_y, wp1_z = go.get_world_position_r(url)
	local wp2_x, wp2_y, wp2_z = go.get_world_position_x(url), go.get_world_position_y(url), go.get_world_position_z(url)
	local wp3_out = { x = 0, y = 0, z = 0 }
	go.get_world_position_t(url, wp3_out)

	-- Get world rotation using different methods
	local we1_x, we1_y, we1_z = go.get_world_euler_r(url)
	local we2_x, we2_y, we2_z = go.get_world_euler_x(url), go.get_world_euler_y(url), go.get_world_euler_z(url)
	local we3_out = { x = 0, y = 0, z = 0 }
	go.get_world_euler_t(url, we3_out)

	-- Get world scale using different methods
	local ws1_x, ws1_y, ws1_z = go.get_world_scale_r(url)
	local ws2_x, ws2_y, ws2_z = go.get_world_scale_x(url), go.get_world_scale_y(url), go.get_world_scale_z(url)
	local ws3_out = { x = 0, y = 0, z = 0 }
	go.get_world_scale_t(url, ws3_out)

	-- Collect all position values
	local pos_x_values = { wp1_x, wp2_x, wp3_out.x }
	local pos_y_values = { wp1_y, wp2_y, wp3_out.y }
	local pos_z_values = { wp1_z, wp2_z, wp3_out.z }

	-- Collect all rotation values
	local rot_x_values = { we1_x, we2_x, we3_out.x }
	local rot_y_values = { we1_y, we2_y, we3_out.y }
	local rot_z_values = { we1_z, we2_z, we3_out.z }

	-- Collect all scale values
	local scale_x_values = { ws1_x, ws2_x, ws3_out.x }
	local scale_y_values = { ws1_y, ws2_y, ws3_out.y }
	local scale_z_values = { ws1_z, ws2_z, ws3_out.z }

	-- Assert all values are equal
	assert(is_equal(pos_x_values), "World Position X values differ: " .. format_values(pos_x_values))
	assert(is_equal(pos_y_values), "World Position Y values differ: " .. format_values(pos_y_values))
	assert(is_equal(pos_z_values), "World Position Z values differ: " .. format_values(pos_z_values))

	assert(is_equal(rot_x_values), "World Rotation X values differ: " .. format_values(rot_x_values))
	assert(is_equal(rot_y_values), "World Rotation Y values differ: " .. format_values(rot_y_values))
	assert(is_equal(rot_z_values), "World Rotation Z values differ: " .. format_values(rot_z_values))

	assert(is_equal(scale_x_values), "World Scale X values differ: " .. format_values(scale_x_values))
	assert(is_equal(scale_y_values), "World Scale Y values differ: " .. format_values(scale_y_values))
	assert(is_equal(scale_z_values), "World Scale Z values differ: " .. format_values(scale_z_values))
end

function update(self, dt)
	time = time + dt

	local url = msg.url("test")
	local vec_in = { x = time, y = time * 2, z = time * 3 }

	-- Run all tests
	test_position(url, vec_in)
	test_scale(url, vec_in)
	test_rotation(url, vec_in)
	test_world_getters(url, vec_in)
end
